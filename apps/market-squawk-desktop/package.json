{
  "name": "@market-squawk/desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.31.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build",
    "bundle:sidecars": "cargo build --release --locked --manifest-path ../../Cargo.toml --package market-squawk --package market-squawk-modeling --features market-squawk-modeling/onnx-tract --bin market-squawk --bin market-squawk-capture-helper --bin market-squawk-onnx-worker",
    "bundle:prepare": "pnpm build && pnpm bundle:sidecars && node scripts/stage-sidecars.mjs",
    "bundle": "tauri build --config src-tauri/tauri.bundle.conf.json",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest",
    "typecheck": "tsc --build"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@tauri-apps/api": "2.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "lucide-react": "1.27.0",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "26.1.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "30.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

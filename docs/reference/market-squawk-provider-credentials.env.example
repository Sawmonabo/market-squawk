# ==============================================================================
# MARKET SQUAWK — DIRECT PROVIDER CREDENTIAL INPUT
# ==============================================================================
#
# Schema: market-squawk-provider-credentials/v1
# One-time local import into Market Squawk's existing protected secret store.
# This is NOT a shell script and must not be sourced. After filling a protected
# owner-local copy, import it through the installed CLI:
#
#   market-squawk source import-credentials \
#     /absolute/path/market-squawk-provider-credentials.env --confirm
#
# The strict importer accepts only this exact ordered v1 key set, transfers
# enabled credentials into the existing onboarding/secret authorities, and
# returns secret-free dispositions. It does not create another provider,
# adapter, service, secret store, or runtime configuration system.
#
# Every *_ENABLED=true value is requested import/probe intent only. It does not
# prove entitlement, start collection, or make a Desktop/CLI/MCP capability
# available. Provider doctor, durable publication, typed reads, and workflow
# composition remain mandatory.
#
# Copy this file outside the repository, replace placeholders, and restrict the
# copy to your local user. Leave disabled-provider secrets empty. Only selected
# providers appear below. Runtime access tokens, discovered account IDs,
# endpoints, provider hard limits, feed classifications, scheduler budgets,
# batch sizes, and collection cadences are deliberately code-owned and absent
# from this input.
# ==============================================================================

MARKET_SQUAWK_PROVIDER_CREDENTIAL_SCHEMA="market-squawk-provider-credentials/v1"

# ==============================================================================
# OPTIONAL CHARLES SCHWAB — OWNER-ENABLED READ-ONLY MARKET DATA
# ==============================================================================
# Supply only the approved application's App Key and App Secret. Register the
# code-owned callback URL exactly as https://127.0.0.1:8182 (no trailing slash)
# in the Schwab portal. The callback is application configuration, not a secret
# or operator input. Access and refresh tokens belong in the protected runtime
# secret store and are deliberately absent here.
# SCHWAB_ENABLED=true imports the application credential and opens the bounded
# onboarding flow; interactive OAuth, entitlement proof, and provider doctor
# remain required before use. Schwab remains optional: unlink/revocation makes
# only Schwab unavailable. The runtime route allowlist contains read-only
# market-data plus the minimum User Preference Streamer bootstrap; it grants no
# account, position, transaction, order, preview, replace, or cancel authority.
# Official numeric REST/batch/Streamer-symbol limits are unpublished, so no
# Schwab capacity value belongs in this credential input.

SCHWAB_ENABLED=false
SCHWAB_APP_KEY=""
SCHWAB_APP_SECRET=""

# ==============================================================================
# ALPACA PAPER ONLY / BASIC — CORE FREE IEX + HISTORY
# ==============================================================================
# The free core uses a Paper Only key pair. Paper Only is email-only and does
# not require live brokerage onboarding. Market Squawk uses market-data
# routes only and grants no order authority. The current key passed indicative
# option REST; option streaming remains doctor-gated. Fixed income returned 403
# and remains unavailable until a changed entitlement passes a fresh doctor.

ALPACA_ENABLED=true
ALPACA_KEY_ID="<ALPACA_KEY_ID>"
ALPACA_SECRET_KEY="<ALPACA_SECRET_KEY>"
ALPACA_TRADING_API_ENVIRONMENT="paper"

# ==============================================================================
# YAHOO FINANCE — NO KEY, ADAPTIVE EXPLICIT-DEMAND ENRICHMENT
# ==============================================================================
# Yahoo publishes no supported Finance market-data API or capacity contract.
# No numeric watchlist, request, batch, daily, or WebSocket limit is published.
# The application owns bounded concurrency, cache/coalescing, a shared 429
# circuit, and runtime admission; those controls are not operator-entered
# provider limits. This enabled lane never authorizes broad scans, scheduled
# WARM collection, NBBO, or sole decision evidence. The runtime must pin its
# source contract and fail closed on crossed, one-sided, stale, untimestamped,
# or changed responses.

YAHOO_FINANCE_EXPERIMENTAL_ENABLED=true
YAHOO_FINANCE_EXPERIMENTAL_BROAD_WARM_ENABLED=false

# ==============================================================================
# NO-KEY OFFICIAL MARKET REFERENCE SOURCES
# ==============================================================================
# These are content-addressed reference/cold lanes, not quote feeds. Nasdaq,
# OCC, and Cboe files are fetched once per applicable publication cycle and
# cached by digest. IEX_HIST_ENABLED only makes exact feed/date cold jobs
# available; it never schedules the full catalog or an automatic daily archive.

NASDAQ_TRADER_REFERENCE_ENABLED=true
OCC_OPTIONS_REFERENCE_ENABLED=true
CBOE_OPTIONS_REFERENCE_ENABLED=true
IEX_HIST_ENABLED=true

# ==============================================================================
# BLS REGISTERED API V2 — LABOR / INFLATION MACRO
# ==============================================================================

BLS_ENABLED=true
BLS_REGISTRATION_KEY="<BLS_REGISTRATION_KEY>"

# ==============================================================================
# BEA — NATIONAL / REGIONAL / INDUSTRY ACCOUNTS
# ==============================================================================

BEA_ENABLED=true
BEA_USER_ID="<BEA_USER_ID>"

# ==============================================================================
# U.S. CENSUS DATA API — ECONOMIC INDICATORS
# ==============================================================================

CENSUS_ENABLED=true
CENSUS_API_KEY="<CENSUS_API_KEY>"

# ==============================================================================
# EIA API V2 — ENERGY MACRO / MARKET FEATURES
# ==============================================================================
# EIA places the key in the query string. The adapter must redact query strings
# from logs, traces, errors, receipts, and diagnostics.

EIA_ENABLED=true
EIA_API_KEY="<EIA_API_KEY>"

# ==============================================================================
# FRED / ALFRED — MANDATORY V1 MACRO / VINTAGE / RELEASE DATA
# ==============================================================================
# One key is used by code-owned authentication modes:
# - v1: redacted api_key query parameter
# - v2: redacted Authorization: Bearer header

FRED_ENABLED=true
FRED_API_KEY="<FRED_API_KEY>"

# ==============================================================================
# OPTIONAL TIINGO STARTER — CURATED EOD / MUTUAL-FUND NAV
# ==============================================================================
# Enable when daily mutual-fund NAV or the curated independent EOD lane is
# required. Disabled means that NAV capability remains explicitly unavailable.

TIINGO_ENABLED=false
TIINGO_API_TOKEN=""

# ==============================================================================
# SEC EDGAR / XBRL / N-PORT / N-CEN — NO SECRET KEY
# ==============================================================================
# SEC requires a truthful identifying User-Agent. Market Squawk constructs it
# from these validated non-secret values.

SEC_ENABLED=true
SEC_USER_AGENT_ORGANIZATION="<YOUR_NAME_OR_ORGANIZATION>"
SEC_USER_AGENT_EMAIL="<MONITORED_CONTACT_EMAIL>"

# ==============================================================================
# NO-CREDENTIAL GOVERNMENT SOURCES
# ==============================================================================

TREASURY_FISCAL_DATA_ENABLED=true
TREASURY_DAILY_RATES_ENABLED=true
FEDERAL_RESERVE_BOARD_DIRECT_ENABLED=true
